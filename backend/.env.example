# Roxbusi API
APP_DEBUG=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL / Aiven
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rozbux
DB_USER=root
DB_PASS=
# Set this to the absolute path of Aiven's ca.pem on the server when needed.
DB_SSL_CA=
DB_SSL_VERIFY=false

# Browser origins; do not use * when Authorization is enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Optional upload storage configuration.
UPLOAD_DIR=
UPLOAD_BASE_URL=/uploads

# Used by database/create_admin.php.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=
ADMIN_PASSWORD=
