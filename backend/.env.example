# Copy this file to ".env" and fill in your local values.

# --- Database (MySQL / XAMPP defaults shown) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rozbox
DB_USER=root
DB_PASS=

# --- Auth ---
# Bắt buộc: chuỗi ngẫu nhiên tối thiểu 32 ký tự (gợi ý: openssl rand -hex 32).
JWT_SECRET=059441ef4c68163eb1b1590c549cee82f40145a3c614431f881904093901f265

# Dùng một lần với "php database/create_admin.php", không commit giá trị thật.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=admin@rozbux.local
ADMIN_PASSWORD=admin123

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://client-pink-seven-61.vercel.app

# Trên Render, gắn Persistent Disk đúng tại /var/www/html/uploads nếu cần giữ ảnh sau deploy.
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=/uploads

# --- App ---
# Set to "true" locally to see real error messages/stack traces.
APP_DEBUG=true
