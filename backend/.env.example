# Copy this file to ".env" and fill in your local values.

# --- Database (MySQL / XAMPP defaults shown) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trendlama
DB_USER=root
DB_PASS=

# --- Auth ---
# Any long random string. Change this before deploying to production.
JWT_SECRET=change-this-secret-in-env

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- App ---
# Set to "true" locally to see real error messages/stack traces.
APP_DEBUG=true
